# Copie para .env (que o git ignora) e preencha.

# Chave da API da Anthropic, usada pelo botão "Interpretar". https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional: troca o modelo. Padrão: claude-opus-5-5.
# Mais barato e rápido: claude-sonnet-5-5 ou claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
