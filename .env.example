# Copie para .env (que o git ignora) e preencha.

# Assistente do painel, via Zyria (API compatível com a da OpenAI).
# Endereço base da API pública, terminando em /api/public/v1.
ZYRIA_BASE_URL=https://SEU_HOST/api/public/v1
# Chave da credencial (zy_live_...). Cada pergunta debita Z Token (ZYT) do saldo.
ZYRIA_API_KEY=

# Opcional: modelo da Zyria. Precisa aceitar tools (function calling); GET /models lista os da credencial.
# Padrão: anthropic/claude-sonnet-5.5. Mais barato: anthropic/claude-haiku-5.5. Mais capaz: anthropic/claude-opus-5.5.
# ZYRIA_MODEL=anthropic/claude-sonnet-5.5
